  "नियम": [
    "महोत्सव में भाग लेने वाले समस्त प्रतिभागियों की जानकारी इसी प्रपत्र पर मान्य होगी।",
    "सभी प्रतिभागी हल्बा समाज से हैं, इसकी पुष्टि ब्लॉक अध्यक्ष द्वारा की जाएगी।",
    "नाम और उम्र के सत्यापन हेतु आधार कार्ड की छायाप्रति अनिवार्य है।",
    "प्रपत्र 15 दिसंबर 2026 तक केंद्रीय महासभा बालोद / अभय हल्बा-हल्बी यूथ विकास एसोसिएशन तक पहुँचना अनिवार्य है।"
  ],
  "स्पष्टता_हेतु": [
